rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsDocument(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validLeaderboardDocument() {
      return request.resource.data.keys().hasOnly(['nickname', 'score', 'mmr', 'lastRunId', 'lastRunHash', 'updatedAt'])
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 1
        && request.resource.data.nickname.size() <= 16
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.score <= 100000000
        && request.resource.data.mmr is int
        && request.resource.data.mmr >= 0
        && request.resource.data.mmr <= 100000000
        && (!request.resource.data.keys().hasAll(['lastRunId']) ||
          (request.resource.data.lastRunId is string && request.resource.data.lastRunId.size() >= 1
            && request.resource.data.lastRunId.size() <= 64))
        && (!request.resource.data.keys().hasAll(['lastRunHash']) ||
          (request.resource.data.lastRunHash is string && request.resource.data.lastRunHash.size() <= 32))
        && request.resource.data.updatedAt == request.time;
    }

    match /leaderboard/{userId} {
      allow read: if true;
      allow create: if ownsDocument(userId) && validLeaderboardDocument();
      allow update: if ownsDocument(userId)
        && validLeaderboardDocument()
        && request.resource.data.score >= resource.data.score
        // Keep this in sync with MmrSettings.MaximumLoss/MaximumGain.
        && (!resource.data.keys().hasAll(['mmr']) ||
          (request.resource.data.mmr >= resource.data.mmr - 150
            && request.resource.data.mmr <= resource.data.mmr + 150));
      allow delete: if false;
    }
  }
}
